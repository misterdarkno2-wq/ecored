DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ecored
DB_USER=ecored
DB_PASSWORD=replace-with-your-database-password
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=replace-with-a-random-key-at-least-32-characters
# Docker Compose utiliza estas variables además de las anteriores.
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
